# Database
DB_NAME=quiz_arena
DB_USER=quiz_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# JWT Secret (min. 32 Zeichen, zufällig generiert)
JWT_SECRET=CHANGE_ME_RANDOM_STRING_AT_LEAST_32_CHARS

# Frontend URL (für CORS)
CLIENT_URL=http://localhost:8080

# Frontend API URL (leer lassen für Nginx-Proxy, oder absolute URL setzen)
VITE_API_URL=

# SMTP (optional - ohne diese Einstellungen werden Verification-Links nur in der Konsole geloggt)
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASS=dein-passwort
# SMTP_FROM=Quiz Arena <noreply@example.com>
